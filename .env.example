# Database Configuration (Docker defaults to port 5432; local cluster defaults to 5433)
DATABASE_URL="postgresql://hostel_user:hostel_password@127.0.0.1:5432/hostel_exchange?schema=public"

# Backend Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET="super-secret-hostel-swap-jwt-key-change-in-prod"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Next.js Frontend Configuration
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="/api"
